      {
        "kind": "pool",
        "command": ["forge", "script", "script/LaunchPool.s.sol:LaunchPool", "--rpc-url", "{anvilRpc}", "--broadcast", "--unlocked", "--sender", "{anvilSender}"]
      },
      {
        "kind": "quadrants",
        "command": ["forge", "test", "--match-path", "test/fork/SwapQuadrants.t.sol", "--fork-url", "{anvilRpc}"]
      },
      {
        "kind": "postconditions",
        "command": ["forge", "test", "--match-path", "test/fork/Postconditions.t.sol", "--fork-url", "{anvilRpc}"]
      }
