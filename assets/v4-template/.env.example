# Copy this file to .env and keep authenticated overrides out of Git.
# These public endpoints are rate-limited convenience defaults, not launch-grade infrastructure.
ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ETH_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
ETHERSCAN_API_KEY=

# Public address only. Keep private keys in a Foundry keystore or hardware wallet.
DEPLOYER_ADDRESS=
