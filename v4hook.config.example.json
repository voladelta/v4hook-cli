{
  "schemaVersion": "v4hook.config.v1",
  "projectRoot": ".",
  "contract": {
    "artifact": "out/MyHook.sol/MyHook.json",
    "constructorArgs": "0x",
    "permissions": ["beforeSwap", "afterSwap"]
  },
  "network": {
    "chainId": 4663,
    "rpcUrlEnv": "ROBINHOOD_MAINNET_RPC_URL",
    "poolManager": "0x8366a39cc670b4001a1121b8f6a443a643e40951",
    "positionManager": "0x58daec3116aae6d93017baaea7749052e8a04fa7",
    "universalRouter": "0x8876789976decbfcbbbe364623c63652db8c0904",
    "quoter": "0x8dc178efb8111bb0973dd9d722ebeff267c98f94",
    "stateView": "0xf3334192d15450cdd385c8b70e03f9a6bd9e673b",
    "permit2": "0x000000000022D473030F116dDEE9F6B43aC78BA3",
    "create2Deployer": "0x4e59b44847b379578588920cA78FbF26c0B4956C"
  },
  "checks": {
    "unit": ["forge", "test", "--match-path", "test/unit/**"],
    "fuzz": ["forge", "test", "--match-path", "test/fuzz/**", "--fuzz-runs", "1000"],
    "invariant": ["forge", "test", "--match-path", "test/invariant/**"],
    "staticAnalysis": ["slither", ".", "--filter-paths", "vendor/", "--fail-high"],
    "minimumFuzzRuns": 1000,
    "minimumInvariantRuns": 256,
    "minimumInvariantDepth": 500
  },
  "simulation": {
    "maxForkBlockDrift": 512,
    "anvilArgs": ["--code-size-limit", "40000"],
    "steps": [
      {
        "kind": "deploy",
        "command": ["forge", "script", "script/DeployHook.s.sol:DeployHook", "--rpc-url", "{anvilRpc}", "--broadcast", "--unlocked", "--sender", "{anvilSender}"]
      },
      {
        "kind": "pool",
        "command": ["forge", "script", "script/SimulatePool.s.sol:SimulatePool", "--rpc-url", "{anvilRpc}", "--broadcast", "--unlocked", "--sender", "{anvilSender}"],
        "requiredAuthorities": {}
      },
      {
        "kind": "quadrants",
        "command": ["forge", "test", "--match-path", "test/fork/SwapQuadrants.t.sol", "--fork-url", "{anvilRpc}"]
      },
      {
        "kind": "postconditions",
        "command": ["forge", "test", "--match-path", "test/fork/Postconditions.t.sol", "--fork-url", "{anvilRpc}"]
      }
    ]
  },
  "deployment": {
    "script": "script/DeployHook.s.sol:DeployHook",
    "requiredAuthorities": {}
  },
  "pool": {
    "currency0": "0x0000000000000000000000000000000000000001",
    "currency1": "0x0000000000000000000000000000000000000002",
    "fee": 3000,
    "tickSpacing": 60,
    "sqrtPriceX96": "79228162514264337593543950336",
    "tickLower": -600,
    "tickUpper": 600,
    "liquidity": "1000000",
    "amount0Max": "1000000000000000000",
    "amount1Max": "1000000000000000000",
    "recipient": "0x0000000000000000000000000000000000000003",
    "hookData": "0x",
    "launchScript": "script/LaunchPool.s.sol:LaunchPool",
    "launchAuthorities": {},
    "simulationSteps": [
      {
        "kind": "pool",
        "command": ["forge", "script", "script/LaunchPool.s.sol:LaunchPool", "--rpc-url", "{anvilRpc}", "--broadcast", "--unlocked", "--sender", "{anvilSender}"]
      },
      {
        "kind": "quadrants",
        "command": ["forge", "test", "--match-path", "test/fork/SwapQuadrants.t.sol", "--fork-url", "{anvilRpc}"]
      },
      {
        "kind": "postconditions",
        "command": ["forge", "test", "--match-path", "test/fork/Postconditions.t.sol", "--fork-url", "{anvilRpc}"]
      }
    ],
    "liveVerify": ["forge", "script", "script/VerifyPool.s.sol:VerifyPool"]
  }
}
